                    "device": "Device",
                    "create_unknown": "Create entities for unknown capabilities",
                    "dump_json": "Dump a JSON file with received data"
                },
                "data_description": {
                    "device": "Devices already set up are left out of the list.",
                    "create_unknown": "Turns every capability the integration cannot name into a diagnostic entity, to work out what its values mean. To report an unknown device, download the diagnostics instead.",
                    "dump_json": "Writes the raw API answer to Cozytouch.json in the configuration directory, on every refresh."
                }
            }
        },
