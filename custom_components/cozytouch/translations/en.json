{
    "title": "Cozytouch",
    "config": {
        "step": {
            "user": {
                "data": {
                    "username": "Username",
                    "password": "Password"
                },
                "data_description": {
                    "username": "The e-mail address the Cozytouch app signs in with.",
                    "password": "The password of that account. It only ever goes to Atlantic's servers."
                }
            },
            "reauth_confirm": {
                "title": "Re-enter your Cozytouch password",
                "description": "Atlantic no longer accepts the stored password for {username}. Enter the current one to reconnect every device on this account.",
                "data": {
                    "password": "Password"
                }
            },
            "devices": {
                "title": "Devices to add",
                "description": "Everything this account reports, gateways and thermal zones included. Leave out what you do not want entities for; you can add it later from the integration page.",
                "data": {
                    "devices": "Devices",
                    "create_unknown": "Create entities for unknown capabilities",
                    "dump_json": "Dump a JSON file with received data"
                },
                "data_description": {
                    "devices": "Everything the account reports is preselected. A device left out here can be added later without setting the account up again.",
                    "create_unknown": "Turns every capability the integration cannot name into a diagnostic entity, to work out what its values mean. To report an unknown device, download the diagnostics instead.",
                    "dump_json": "Writes the raw API answer to Cozytouch.json in the configuration directory, on every refresh."
                }
            }
        },
        "abort": {
            "already_configured": "This account is already configured",
            "reauth_successful": "Re-authentication was successful",
            "no_devices": "This Cozytouch account reports no device"
        },
        "error": {
            "cannot_connect": "Cannot connect to Atlantic Cozytouch servers",
            "invalid_auth": "Invalid Atlantic Cozytouch authentication",
            "unknown": "Unknown error"
        }
    },
    "config_subentries": {
        "device": {
            "entry_type": "Device",
            "initiate_flow": {
