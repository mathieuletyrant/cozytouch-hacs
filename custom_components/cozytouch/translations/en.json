    "issues": {
        "unknown_model": {
            "title": "{device_name} is a model this integration does not know",
            "fix_flow": {
                "step": {
                    "confirm": {
                        "title": "Send the report",
                        "description": "Model id `{model_id}` is not in the mapping table, so only this device's generic capabilities work. What is missing is a mapping someone has to write, and writing it needs two things from you.\n\n[Open a pre-filled issue]({report_url}). It carries every unmapped model on this account (`{model_ids}`) with the capability ids nothing names for each -- and nothing else about your home.\n\nThen attach a diagnostics dump to it, from *Settings > Devices & Services > Atlantic Cozytouch > ⋮ > Download diagnostics*, one per device in the report : a dump carries the capability values of the device it came from, and identity only for the rest. Your credentials and address are stripped out.\n\nSelect **Submit** once it is sent. One report answers for every device in it, so the other unmapped-device repairs on this account go with this one. A release that adds a mapping clears it either way."
                    }
                }
            }
        }
    },
    "services": {
        "set_schedule": {
            "name": "Set a day program",
            "description": "Writes the same time program to one or more days, for heating or cooling.",
            "fields": {
                "program":  { "name": "Program", "description": "Heating or cooling." },
                "days":     { "name": "Days", "description": "The days that will receive this program." },
                "slots":    { "name": "Slots", "description": "List of time/temperature pairs. The first slot must start at 00:00, ten at most." }
            }
        }
    }
